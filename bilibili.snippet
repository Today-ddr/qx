#!name=哔哩哔哩去广告净化
#!desc=过滤Bilibili广告、移除青少年模式弹窗和交互式弹幕、移除无用功能和链接跟踪参数。移植自可莉 (iKeLee) Loon 插件，底层由 Maasea (gRPC) 与 RuCu6 (JSON) 协同驱动。
#!author=Maasea, RuCu6, iKeLee
#!homepage=https://github.com/Today-ddr/qx
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/bilibili.png

# ======= 静态请求拦截与重定向 ======= #
# 开屏静态资源拦截
^http:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH url reject-dict
^http:\/\/[\d\.]+:8000\/v1\/resource\/\w{32}-1-SPLASH url reject-dict
^https:\/\/api\.bilibili\.com\/x\/mengqi\/v1\/resource\? url reject-dict

# 满意度调研与上报拦截
^https:\/\/api\.bilibili\.com\/x\/v2\/dm\/qoe\/show\? url reject-dict
^https:\/\/app\.bilibili\.com\/x\/resource\/ip url reject
^https:\/\/api\.bilibili\.com\/x\/web-interface\/zone\?jsonp url reject-200

# 搜索建议、热搜与大家都在搜拦截
^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ url reject
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words url reject-dict

# 动态话题与最常访问拦截
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr url reject-dict
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist url reject-dict

# 推广与直播带货拦截
^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/season\/app\/related\/recommend\? url reject-dict
^https:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? url reject-dict

# 漫画广告拦截
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash) url reject-dict

# 移除视频与直播间链接跟踪参数 (buvid, share_source 等)
((^https:\/\/(www|m)\.bilibili\.com\/video\/((BV\w{10})|(av\d{9}))))((\/\?buvid=.*)|(\/\?share_source=.*)|(\?p=.*)) url 302 $1
(^https:\/\/live\.bilibili\.com\/\d+)((\?broadcast_type.*)|(\?launch_id.*)) url 302 $1


# ======= gRPC / Protobuf 协议处理 (Maasea) ======= #
# 播放页面推广与相关视频推荐净化
^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|ViewProgress)$ url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js

# 搜索结果广告净化
^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$ url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js

# 评论区广告净化
^https:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js

# 动态页面广告净化
^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$ url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js

# 会员特效弹幕与交互式弹幕拦截
^https:\/\/grpc\.biliapi\.net\/bilibili\.community\.service\.dm\.v1\.DM\/(DmSegMobile|DmView) url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js

# 青少年模式弹窗拦截
^https:\/\/grpc\.biliapi\.net\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili.helper.js


# ======= JSON / REST 界面与流净化处理 (RuCu6) ======= #
# 开屏广告
^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/(brand\/list|event\/list2|list|show)\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 首页推荐信息流净化 (只保留视频，过滤广告、带货、直播)
^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 首页右上角活动入口屏蔽
^https:\/\/app\.bilibili\.com\/x\/resource\/top\/activity\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 竖屏视频流广告屏蔽
^https:\/\/app\.bilibili\.com\/x\/v2\/feed\/index\/story url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 顶部 Tab (首位默认推荐) 与 底部导航栏精简 (仅保留首页、动态、我的)
^https:\/\/app\.bilibili\.com\/x\/resource\/show\/tab\/v2\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 搜索框历史与热搜净化
^https:\/\/app\.bilibili\.com\/x\/v2\/search\/square url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 观影页/追番页推广净化
^https:\/\/api\.bilibili\.com\/pgc\/page\/(bangumi|cinema\/tab\?) url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 直播间横幅与带货推广净化
^https:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 皮肤推送拦截
^https:\/\/app\.bilibili\.com\/x\/resource\/show\/skin\? url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

# 个人中心（“我的”页面）精简 (去除牛皮癣推广)
^https:\/\/app\.bilibili\.com\/x\/v2\/account\/(mine\?|mine\/ipad\?|myinfo) url script-response-body https://raw.githubusercontent.com/Today-ddr/qx/main/scripts/bilibili_remove_ads.js

hostname = app.bilibili.com, api.bilibili.com, api.live.bilibili.com, grpc.biliapi.net, www.bilibili.com, m.bilibili.com, live.bilibili.com, api.vc.bilibili.com, manga.bilibili.com, upos-sz-static.bilivideo.com
